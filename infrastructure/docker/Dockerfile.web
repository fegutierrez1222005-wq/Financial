# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS deps
WORKDIR /srv
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund || npm install --no-audit --no-fund

FROM node:22-alpine AS build
WORKDIR /srv
COPY --from=deps /srv/node_modules ./node_modules
COPY apps/web ./
RUN npm install --no-audit --no-fund && npm run build

FROM node:22-alpine AS runtime
WORKDIR /srv
ENV NODE_ENV=production
RUN addgroup -g 10002 finagent && adduser -D -u 10002 -G finagent finagent

COPY --from=build /srv/.next ./.next
COPY --from=build /srv/public ./public
COPY --from=build /srv/node_modules ./node_modules
COPY --from=build /srv/package.json ./package.json
COPY --from=build /srv/next.config.mjs ./next.config.mjs

USER finagent
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://localhost:3000/ >/dev/null || exit 1

CMD ["npm", "run", "start"]
