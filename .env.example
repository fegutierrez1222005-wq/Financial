# Copy to .env and fill in what you have. Everything here is optional except SECRET_KEY
# in a non-development deployment: a provider with no credentials reports itself
# unavailable rather than silently falling back to synthetic data.

# ------------------------------------------------------------------------- product
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------ security
# Signs sessions and derives the secret-encryption key. The application refuses to
# start in production while this is still the development default.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
REQUIRE_MFA_FOR_ADMINS=false

# ------------------------------------------------------------------------ database
DATABASE_URL=postgresql+psycopg://finagent:finagent@localhost:5432/finagent

# ---------------------------------------------------------------------------- jobs
JOB_BACKEND=inline               # inline | celery  (celery is required in production)
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------- providers
# Model providers. Without any of these the platform runs on the deterministic local
# provider and every artefact it produces is labelled as simulated.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Market and filing data. Without these the demo provider serves the fictional ACME
# dataset, which is labelled as demo data wherever it appears.
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
# SEC EDGAR requires a contact string of the form "Company Name contact@example.com".
SEC_USER_AGENT=

ENABLE_DEMO_PROVIDERS=true
DEFAULT_MODEL=
JUDGE_MODEL=
EMBEDDING_PROVIDER=auto          # auto | openai | deterministic

# ----------------------------------------------------------------------- execution
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=300
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_SECONDS=15
MAX_UPLOAD_BYTES=104857600

# ---------------------------------------------------------------------- rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_USER_PER_MINUTE=240
RATE_LIMIT_PER_WORKSPACE_PER_MINUTE=600
RATE_LIMIT_PER_API_KEY_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20

# -------------------------------------------------------------------------- storage
STORAGE_DIR=./storage

# -------------------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text

# ------------------------------------------------------------------------- frontend
# Read by the Next.js server only. The browser never sees it and never calls the API
# directly: the session lives in an httpOnly cookie and every request is proxied by a
# server component or server action.
FINAGENT_API_URL=http://localhost:8000

# Optional SSO adapters. Unset providers are reported as unavailable at sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
OKTA_AUTHORIZE_URL=
OKTA_TOKEN_URL=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
