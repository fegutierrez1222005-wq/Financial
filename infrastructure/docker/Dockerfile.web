# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
WORKDIR /srv

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY apps/web ./
RUN npm run build

# The standalone output carries only the server and the modules it actually traced, so
# no build tooling, no devDependencies and no source reach the runtime image.
FROM node:22-alpine AS runtime
WORKDIR /srv
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -g 10002 finagent && adduser -D -u 10002 -G finagent finagent

COPY --from=build --chown=finagent:finagent /srv/.next/standalone ./
COPY --from=build --chown=finagent:finagent /srv/.next/static ./.next/static
COPY --from=build --chown=finagent:finagent /srv/public ./public

USER finagent
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://localhost:3000/ >/dev/null || exit 1

CMD ["node", "server.js"]
